# Copiá este archivo a .env.local y completá con las keys reales de Supabase
# (Project Settings > API en el dashboard de Supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# OJO: esta key bypassa la seguridad (RLS). Nunca exponerla al browser,
# nunca commitearla. Solo se usa server-side (route handlers, bot de WhatsApp).
SUPABASE_SERVICE_ROLE_KEY=
